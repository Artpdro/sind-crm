# Copie para /opt/sindnorte/backend/.env  e  chmod 600
APP_ENV=production
DATABASE_URL=sqlite:///./data/sindnorte.db
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://empresas.SEUDOMINIO.com.br
FRONTEND_BASE_URL=https://empresas.SEUDOMINIO.com.br
# atrás do Caddy (que sobrescreve o X-Forwarded-For): necessário para o limite de tentativas por IP
TRUST_PROXY_HEADERS=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GEOCODER_AUTO=true
# seu e-mail de contato (a política do OpenStreetMap pede)
GEOCODER_EMAIL=ti@SEUDOMINIO.com.br
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_MIN_INTERVAL=1.1
GEOCODER_ALLOW_LOCAL=false
PDF_MAPA_RUAS=true
