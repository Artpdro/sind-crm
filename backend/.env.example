# Copie para .env (NUNCA commite o .env). O sistema roda SEM .env com estes padrões de desenvolvimento,
# exceto COOKIE_SECURE, que em http://localhost precisa ser false.
APP_ENV=development
# arquivo local; nada para instalar
DATABASE_URL=sqlite:///./data/sindnorte.db
# em produção (HTTPS) DEVE ser true (a app recusa iniciar se não for)
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
RESET_TOKEN_MINUTES=30
# SMTP para recuperação de senha (opcional; sem isso use: python -m scripts.admin reset-password USUARIO)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Geocodificação (Nominatim/OpenStreetMap) ──
# empresa nova/alterada/importada é mapeada sozinha, em segundo plano (false = só manual)
GEOCODER_AUTO=true
# SEU contato (ex.: ti@sindnorte.org.br). A política do Nominatim pede; vai no User-Agent
GEOCODER_EMAIL=
GEOCODER_URL=https://nominatim.openstreetmap.org
# segundos entre consultas (a política permite no máximo 1 por segundo; não diminua)
GEOCODER_MIN_INTERVAL=1.1
# true só se você tiver um Nominatim PRÓPRIO em localhost
GEOCODER_ALLOW_LOCAL=false

# Mapa de ruas no PDF (OpenStreetMap). Use false para desligar e usar só o mapa esquemático.
PDF_MAPA_RUAS=true

# Consulta da situação cadastral (ativa/inativa/inapta) na Receita Federal, via serviço público que espelha a base dela
RECEITA_ATIVO=true
RECEITA_URL=https://brasilapi.com.br/api/cnpj/v1/{cnpj}
RECEITA_TIMEOUT=8
RECEITA_CACHE_HORAS=24
